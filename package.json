{
  "name": "nethack-tiles-client",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "pnpm test && pnpm run test:backend",
    "test:live-login": "cargo test --manifest-path src-tauri/Cargo.toml --test live_login -- --ignored --nocapture",
    "test:local-game": "cargo test --manifest-path src-tauri/Cargo.toml --lib the_installed_nethack_starts_and_draws -- --ignored --nocapture",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tiles": "cargo run --manifest-path src-tauri/Cargo.toml --example tiles2png --",
    "icon": "cargo run --manifest-path src-tauri/Cargo.toml --example appicon -- --out app-icon.png --size 1024 && tauri icon app-icon.png",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs",
    "release:macos": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
